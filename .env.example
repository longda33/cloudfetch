# ===== 服务 =====
PORT=3000
# 访问密码。留空时服务会拒绝所有访问（fail-closed），不会放行
PANEL_PASSWORD=
# 会话签名密钥，随便一串长随机字符。
# 留空会自动生成随机密钥，但重启后需要重新登录。
# 千万不要用任何"默认值"——签名算法是公开的，默认密钥等于没有鉴权。
SESSION_SECRET=change-me-to-a-long-random-string

# ===== 存储 =====
# 下载临时目录。Cloady 免费额度存储仅 5GB，建议用 /tmp
DATA_DIR=/tmp/cloudfetch
# 单文件大小上限（字节），默认 20GB
MAX_FILE_SIZE=21474836480
# 最大并发任务数
MAX_CONCURRENT=2
# 队列长度上限（排队中 + 运行中），防止一次提交几千条链接把进程拖死
MAX_QUEUE=100

# ===== 下载行为 =====
# 连接超时（毫秒）
CONNECT_TIMEOUT=30000
# 空闲超时：多久没数据判定卡死并重连（毫秒）
IDLE_TIMEOUT=60000
# HTTP 分片大小
CHUNK_SIZE=8388608
# 分片并发数
CHUNK_CONCURRENCY=4

# ===== 重试策略 =====
# 最大重试次数
RETRY_MAX_ATTEMPTS=8
# 首次退避（毫秒），之后指数增长
RETRY_BASE_DELAY=2000
# 最大退避（毫秒）
RETRY_MAX_DELAY=60000
# 直播流：连续多少次无数据才放弃
LIVE_MAX_EMPTY_RETRIES=12
# 直播流：断流重连间隔（毫秒）
LIVE_RECONNECT_DELAY=3000

# ===== OpenList =====
# OpenList 站点地址，如 https://pan.example.com
OPENLIST_URL=
# API 令牌（OpenList 后台 → 设置 → 其他 → 令牌）
OPENLIST_TOKEN=
# 或者用账号密码（token 留空时生效）
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
# 上传目标目录
OPENLIST_UPLOAD_DIR=/cloudfetch
# 按日期建子目录
OPENLIST_DATE_SUBDIR=true
# 上传成功后删除本地文件
DELETE_AFTER_UPLOAD=true
# 上传失败重试次数
UPLOAD_RETRIES=5

# ===== 其他 =====
# ffmpeg 路径（容器内已装，保持默认即可）
FFMPEG_PATH=ffmpeg
# 任务记录保留条数
MAX_TASKS=200

# ===== 转码链路（Cloudflare R2 + GitHub Actions）=====
# 作用：录制完的 FLV 先传 R2，再由 GitHub Actions（4 核）转成 H.264 MP4，
#       转完自动传回 OpenList，并删掉 R2 里的源文件。
# 全部留空 = 关闭转码，行为退回「FLV 直接传 OpenList」。
# R2 控制台 → R2 → Manage R2 API Tokens → Create API Token（Object Read & Write）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cloudfetch
# 可选，兼容 MinIO/B2；留空按 accountId 自动拼 R2 地址
R2_ENDPOINT=
R2_PREFIX=cloudfetch
R2_PRESIGN_EXPIRES=3600

# GitHub Actions 触发配置
# PAT 需要 Actions: Read and write 权限，且仓库在授权列表里
TRANSCODE_ENABLED=true
GH_REPO=longda33/cloudfetch
GH_WORKFLOW=transcode.yml
GH_REF=main
GH_TOKEN=
# H.264 CRF，越小越清晰体积越大；23 是常用平衡点
TRANSCODE_CRF=23
TRANSCODE_PRESET=veryfast